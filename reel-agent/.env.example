# OPTIONAL – alle wichtigen Einstellungen gehen bequemer in der App unter ⚙️.

# ── Claude (schreibt die Drehbücher) ─────────────────────────────
# API-Key von https://console.anthropic.com/  – ohne Key läuft der Agent im Offline-Modus.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ── Marke ───────────────────────────────────────────────────────
BRAND_NAME=Seelenwende
BRAND_HANDLE=@_seelenwende
# BRAND_VOICE=warm, achtsam, ermutigend – Themen rund um Selbstfindung und innere Ruhe

# ── Instagram (zum direkten Veröffentlichen) ────────────────────
# Langlebiges Access Token + Instagram-User-ID deines Business-/Creator-Kontos (siehe README).
IG_ACCESS_TOKEN=
IG_USER_ID=
# graph.instagram.com (Instagram Login, Standard) oder graph.facebook.com (Facebook Login)
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v23.0
# resumable = Video direkt hochladen (Standard) · url = Instagram holt das Video über PUBLIC_BASE_URL
IG_UPLOAD_MODE=resumable
# PUBLIC_BASE_URL=https://mein-server.de

# ── Server ──────────────────────────────────────────────────────
PORT=3000
# 127.0.0.1 = nur auf diesem Rechner erreichbar · 0.0.0.0 = im Netzwerk erreichbar (dann APP_PASSWORD setzen!)
HOST=127.0.0.1
# APP_PASSWORD=

# Zeitzone für geplante Posts
# TZ_NAME=Europe/Berlin
